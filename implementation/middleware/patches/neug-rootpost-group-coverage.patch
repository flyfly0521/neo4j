+// One FILL into a REL group routes each reachable pair to the child table of
+// its endpoint labels (LDBC ROOT_POST(FROM Comment TO Post, FROM Post TO Post)
+// filled from (message:Comment:Post)). That single entry covers every pair of
+// the endpoint label product; it is not a per-pair dispatched family.
+TEST_F(DerivedRelationRewriteMetadata, RecursiveGroupFillCoversEveryChildPair) {
+  registerFill("ReachGroup()", "MATCH (message:A:B)-[:Path*0..]->(root:A) "
+               "RETURN DISTINCT message.id, root.id");
+  for (const auto& query : {
+           "MATCH (message:A:B)-[:Path*0..]->(root:A) "
+           "RETURN DISTINCT message.id AS m, root.id AS r",
+           "MATCH (root:A)<-[:Path*0..]-(message:A:B) "
+           "RETURN root.id AS r, count(DISTINCT message) AS count"}) {
+    auto result = prepare(query);
+    ASSERT_TRUE(result->isSuccess());
+    const auto rel = findShortcut(result->logicalPlan->getLastOperator());
+    ASSERT_NE(rel, nullptr) << query << "\n" << result->logicalPlan->toString();
+    EXPECT_EQ(rel->getSrcNode()->getVariableName(), "message");
+    EXPECT_EQ(rel->getDstNode()->getVariableName(), "root");
+    EXPECT_EQ(rel->getDirectionType(), RelDirectionType::SINGLE);
+    EXPECT_EQ(rel->getEntries().size(), 2u);
+  }
+}
+
+TEST_F(DerivedRelationRewriteMetadata, RecursiveGroupFillKeepsSetAndBoundGuards) {
+  registerFill("ReachGroup()", "MATCH (message:A:B)-[:Path*0..]->(root:A) "
+               "RETURN DISTINCT message.id, root.id");
+  for (const auto& query : {
+           "MATCH (message:A:B)-[:Path*0..]->(root:A) RETURN count(*) AS count",
+           "MATCH (message:A:B)-[:Path*1..]->(root:A) "
+           "RETURN DISTINCT message.id AS m, root.id AS r",
+           "MATCH (message:A:B)-[:Path*0..]-(root:A) "
+           "RETURN DISTINCT message.id AS m, root.id AS r"}) {
+    auto result = prepare(query);
+    ASSERT_TRUE(result->isSuccess());
+    EXPECT_EQ(findShortcut(result->logicalPlan->getLastOperator()), nullptr) << query;
+  }
+}
